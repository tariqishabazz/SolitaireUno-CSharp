@page "/"
@using SolitaireUno

<PageTitle>Solitaire Uno</PageTitle>


<div class="text-center">
        
    @if (!gameStarted)
        {
            gameOverMessage = "";

            <div class="game-setup-screen card p-4 mx-auto shadow-sm mt-4">
                <h4 class="mb-3 text-dark">Game Setup</h4>
            
                <details class="text-start mt-2 p-3 rounded shadow-sm" style="background-color: rgba(0,0,0,0.05); border: 1px solid rgba(0,0,0,0.1);">
                <summary class="fw-bold text-dark user-select-none" style="cursor: pointer;">
                    📖 How to Play Solitaire Uno
                </summary>
                <div class="mt-3 text-dark small">
                    <p><strong>Goal:</strong> Be the first player to empty your hand!</p>
                    <p><strong>Rules:</strong> Match the top card of the discard pile by <strong>Color</strong>, <strong>Value</strong>, or <strong>Suit</strong> (if enforced).</p>
                    <p><strong>Special Cards:</strong> Use Action cards like Skip, Draw Two, and Draw Four to disrupt your opponents.</p>
                    <p class="mb-0 text-muted"><em>Tip: Use the sorting dropdown above to keep your hand organized!</em></p>
                </div>
            </details>

            <br />
            <br />

            <label class = "form-label fw-bold text-dark text-start">What is your name:</label>
            <input type="text" @bind="playerName" placeholder="Type name here..."/>
                
            <br />

            <label class="form-label fw-bold text-dark text-start">Game Mode</label>
                <select class="form-select mb-3" @bind="selectedMode">
                    <option value="@GameMode.Ascending">Ascending</option>
                    <option value="@GameMode.Descending">Descending</option>
                    <option value="@GameMode.Both"> Both</option>
                </select>

	

                <label class="form-label fw-bold text-dark text-start">Difficulty</label>
                <select class="form-select mb-4" @bind="selectedDifficulty">
                    <option value="@GameDifficulty.Easy">Easy</option>
                    <option value="@GameDifficulty.Medium">Medium</option>
                    <option value="@GameDifficulty.Hard">Hard</option>
                </select>


                <label class="form-label fw-bold text-dark text-start">Card Backing Color</label>
                <select class="form-select mb-4" @bind="selectedCardColor" >
                    <option value="yellow">Yellow</option>
                    <option value="red">Red</option>
                    <option value="blue">Blue</option>
                    <option value="green">Green</option>
                </select>

                <label class="form-label fw-bold text-dark text-start">Sorting Method</label>
                <select class="form-select mb-4" @bind="selectedSortMethod">
                    <option value="Values">By Values</option>
                    <option value="Suits">By Suits</option>
                    <option value="By Suits, then Values">Both</option>
                </select>

                <label class="form-label fw-bold text-dark text-start">Numbers of Players (excluding you)</label>
                <select class="form-select mb-4" @bind="selectedPlayerCount">
                <option value="1">One (~ mins)</option>
                    <option value = "2">Two (~ mins)</option>
                    <option value = "3">Three (~ mins)</option>
                    <option value="4">Four (~ mins)</option>
                    <option value="5">Five (~ mins)</option>
                </select>


                <div class="form-check mb-4 text-start">
                    <input class="form-check-input" type="checkbox" id="suitEnforcement" @bind="suitEnforcement" />
                    <label class="form-check-label fw-bold text-dark" for="suitEnforcement"> Enable Suit Enforcement </label>
                </div>

                <button class="btn btn-lg btn-success w-100 fw-bold" @onclick="StartNewGame">Start Game</button>
            
     
            
            </div>
        }

    
    else
    {
        <div class="solitaire-table">
        
            <aside class="table-sidebar">
                <div class="game-name-and-uptime">
                    <h3 class="title" style=" color: #fff">SolitaireUno</h3>
                    <h6 class="uptimer text-danger mb-3 text-light">
						Game Uptime: @_gameUptime.ToString(@"hh\:mm\:ss")
                        
                    </h6>
                    <hr class="text-white" />
                </div>

                <div class="game-info fw-bold" role="alert">
                    <div class="game-stats d-flex flex-column gap-2 mt-3">

                        <span class="badge rounded-pill text-start text-wrap py-1 px-2 small" style="background-color: #0d6efd;">
                            Card Order: @gameEngine?.CurrentGameSettings.Mode
                        </span>

                        <span class="badge rounded-pill text-start text-wrap py-1 px-2 small" style="background-color: #0dcaf0; color: #000;">
                            Hand Sorting: @(selectedSortMethod ?? "None")
                        </span>

                        <span class="badge rounded-pill text-start text-wrap py-1 px-2 small" style="background-color: #dc3545;">
                            Suits Enforced: @(suitEnforcement ? "Yes" : "No")
                        </span>

                        @if (gameEngine?.GameDeck?.Length() > 1)
                        {
                            <span class="badge rounded-pill text-start text-wrap py-1 px-2 small" style="background-color: #ffc107; color: #000;">
                                Deck: @gameEngine?.GameDeck?.Length() cards left
                            </span>
                        }
                        else if (gameEngine?.GameDeck?.Length() == 1)
                        {
                            <span class="badge rounded-pill text-start text-wrap py-1 px-2 small" style="background-color: #ffc107; color: #000;">
                                Deck: 1 card left!
                            </span>
                        }
                        else
                        {
                            <span class="badge rounded-pill text-start text-wrap py-1 px-2 small" style="background-color: #ffc107; color: #000;">
                                Deck: Empty. If allowed, draw!
                            </span>
                        }

                        <span class="badge rounded-pill text-start text-wrap py-1 px-2 small" style="background-color: #b3e917; color: #000;">
                            Deck shuffled: @gameEngine?.GameDeck.ReshuffleCount/@(gameEngine?.CurrentGameSettings.Mode is GameMode.Both ? 2 : 1 ) time(s)
                        </span>

                        @if(gameEngine?.CurrentState is not null && gameEngine?.CurrentState.LeapFrogMode == true)
                        {
                            <span class="badge rounded-pill text-start text-wrap py-1 px-2 small" style="background-color: #dc3545;">
                                Leapfrog Mode is on
                            </span>
                        }


                    </div>
                </div>

                <header class="opponent-zone mt-4">
                    <!-- flex-row on mobile, flex-md-column on desktop sidebars -->
                    <div class="d-flex flex-row flex-md-column flex-wrap gap-1">
                        @if (gameEngine is not null)
                        {
                            @foreach (Player player in gameEngine.AllPlayers)
                            {
                                <div class="opponent-hud m-0">
                                    <span class="fw-bold">@player.Name</span>
                                    <span class="card-count">@player.Hand.Count</span>
                                    
                                    @if (player.Hand.Count > 1 || player.Hand.Count == 0) { <small>Cards</small> }
                                    @if(player.Hand.Count == 1) { <small>Card</small> }
                                </div>
                            }
                        }
                    </div>
                </header>

            </aside>


            <div class="game-board-column">


            <div class="round-message text-warning mt-3">
                @actionLog
            </div>

         

            

                <main class="active-play-area">
                
                    <div class="text-center">
                        <div class="solitaire-deck" @onclick='() => PlayHumanTurn("pickup")'>
                            <img src=@($"images/cards/{selectedCardColor}_backing.png") alt="Deck" />
                        </div>
                    </div>

                    @if (gameEngine?.CurrentState is not null)
                    {
                        <div class="text-center" @key="gameEngine?.CurrentState.VisualCard">
                            <div class="discard-pile solitaire-card animate-play"
                            @onclick='() => PlayHumanTurn("gimmeTheLastDiscard")'>
                                <img src="@GetCardImagePath(gameEngine?.CurrentState.VisualCard)" alt="@gameEngine?.CurrentState.VisualCard?.ToString()" />
                            </div>
                        </div>
                    }

                    @if (gameEngine?.CurrentState is not null && gameEngine?.CurrentState.VisualCard is SpecialCard)
                    {
                        <div class="text-center ms-4 underneath-card">
                            <div class="solitaire-card">
                                <img src="@GetCardImagePath(gameEngine?.CurrentState.LogicCard)" alt="@gameEngine?.CurrentState.LogicCard?.ToString()" />
                            </div>
                        
                            <span class="text-white mt-2 d-block fw-bold">
                                Underneath
                            </span>
                        </div>
                    }
                </main>







                <footer class="player-zone">
                    <div class="player-controls">
                        
                        @if(gameOverMessage == "")
                        {
                           <button class="btn btn-outline-light px-4" @onclick='() => PlayHumanTurn("pass")'>
                                Pass Turn
                            </button>
                        }
                        
                        else
                        {
                            <div class="game-over-message">
                                    <h3 class="text-success mt-4">
                                        @gameOverMessage
                                    </h3>

                                    <button class="btn mt-3 px-4 text-light"
                                            @onclick='() => StartNewGame()'>
                                        Play Again
                                    </button>

                                    <button class="btn mt-3 px-4 text-light"
                                            @onclick='() => gameStarted = false'>
                                        Main Menu
                                    </button>
                            </div>
                        }


                        <h4 class="mt-4 text-white">
                            Your Hand ~ @gameEngine?.AllPlayers[0].Hand.Count card(s)
                        </h4>

                    </div>
                    

                    <div class="card-scroller d-flex flex-wrap justify-content-center gap-2 mt-3 p-2">
                        @for (int i = 0; i < gameEngine?.AllPlayers[0].Hand.Count; i++)
                        {
                            var card = gameEngine?.AllPlayers[0].Hand[i];
                            int buttonIndex = i + 1;
                            int totalCards = gameEngine?.AllPlayers[0].Hand.Count ?? 1;

                            <div @key="card" class="card-draw-wrapper animate-draw" >
                                <div class="radial-card-fan mb-3" data-flat="@(totalCards >= 12)" 
                                     style="--index: @i; --total: @totalCards">

                                        <div class="solitaire-card" @onclick='() => PlayHumanTurn(buttonIndex.ToString())'>
                                            <img src="@GetCardImagePath(card)" alt="@card?.ToString()" />
                                        </div>

                                 </div>
                            </div>
                        }

                    </div>

                   
                </footer>
                </div>
            </div>
    }
</div>

